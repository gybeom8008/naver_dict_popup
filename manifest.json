{
  "manifest_version": 3,
  "name": "네이버 사전 (비공식)",
  "version": "1.4.0",
  "description": "네이버 사전 검색창에서 첫 글자의 한/영이 뒤바뀌는 문제에 대응해, 검색창에 미리 커서를 놓는 옵션을 제공합니다. 사전은 툴바 팝업에서 모바일 뷰로 열립니다.",

  "browser_specific_settings": {
    "gecko": {
      "id": "naver-dict-popup@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "action": {
    "default_title": "네이버 사전",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },

  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],

  "host_permissions": [
    "*://dict.naver.com/*",
    "*://*.dict.naver.com/*",
    "*://*.naver.net/*",
    "*://*.pstatic.net/*"
  ],

  "background": {
    "scripts": ["common/defaults.js", "background.js"]
  },

  "content_scripts": [
    {
      "matches": ["*://dict.naver.com/*", "*://*.dict.naver.com/*"],
      "js": ["common/defaults.js", "content/naver-dict.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
